-- Teleport attack: TP behind target -> look at them -> wait -> action -> TP back
local tpAttackBusy = false
local function teleportAttack(label: string, fn: (string) -> ())
	if tpAttackBusy then return end
	local target = resolveTarget(targetBox.Text)
	if not target then
		mStatus.Text = label .. ": no target entered"
		mStatus.TextColor3 = C_KILLER
		return
	end
	local targetPlayer = Players:FindFirstChild(target)
	if not targetPlayer then
		mStatus.Text = label .. ": player not found (" .. target .. ")"
		mStatus.TextColor3 = C_KILLER
		return
	end
	local tChar = targetPlayer.Character
	local myChar = localPlayer.Character
	local tRoot = tChar and (tChar:FindFirstChild("HumanoidRootPart") or tChar.PrimaryPart)
	local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
	if not tRoot or not myRoot then
		mStatus.Text = label .. ": no character available"
		mStatus.TextColor3 = C_KILLER
		return
	end

	tpAttackBusy = true
	local returnCFrame = myRoot.CFrame
	startCameraLook(myRoot, tRoot)                      -- face them while there

	-- Frames run 0..frames (frame 0 = initial placement, 1..frames each after a
	-- Heartbeat so the position replicates). We fire at most `calls` times and
	-- ALWAYS fire on the second-to-last frame, filling the rest of the budget
	-- from the trailing (most-replicated) frames.
	local frames     = tpStabFrames
	local calls      = math.clamp(tpStabCalls, MIN_TP_CALLS, MAX_TP_CALLS)
	local secondLast = math.max(0, frames - 1)
	local fireOn: { [number]: boolean } = { [secondLast] = true }
	local used = 1
	local f = frames
	while used < calls and f >= 0 do
		if not fireOn[f] then
			fireOn[f] = true
			used += 1
		end
		f -= 1
	end

	for i = 0, frames do
		if i > 0 then
			RunService.Heartbeat:Wait()               -- let the position replicate
		end
		if tRoot.Parent and myRoot.Parent then
			if undergroundEnabled then
				myRoot.CFrame = tRoot.CFrame * CFrame.new(0, -tpDistance, 0)  -- under, below ground
			else
				myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, tpDistance)   -- behind them
			end
		end
		if fireOn[i] then
			pcall(fn, target)
		end
	end
	stopCameraLook()
	if myRoot and myRoot.Parent then
		myRoot.CFrame = returnCFrame                   -- back to the start
	end
	tpAttackBusy = false
	mStatus.Text = string.format("%s → %s", label, target)
	mStatus.TextColor3 = C_VIGIL
end


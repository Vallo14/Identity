local resultCount = 0 -- counted (non-ignored) fires
local cardOrder   = 0 -- monotonic ordering for every card, ignored or not

local function addResult(killType: any, killer: any, victim: any, ignored: boolean)
	cardOrder += 1

	local killerName = nameOf(killer)
	local victimName = nameOf(victim)
	local typeText   = killType ~= nil and tostring(killType) or "?"
	local verb       = verbFor(killType)
	local accent     = ignored and C_VIGIL or colorFor(killType)
	local stamp      = os.date("%H:%M:%S")
	local recordedKiller: string? = nil  -- set if this card credits a killer

	print(string.format("[Identity Monitor] %s%s | Killer: %s | %s: %s",
		ignored and "(discussion/vigilante) " or "", typeText, killerName, verb, victimName))

	-- Only real (non-discussion) kills count and flag a killer.
	if not ignored then
		resultCount += 1
		eCount.Text = "Fires: " .. tostring(resultCount)
		if killerName ~= "" and killerName ~= "?" then
			recordedKiller = killerName
			killersSeen[killerName] = (killersSeen[killerName] or 0) + 1
			if updateHighlights then updateHighlights() end
			if refreshDisguises then refreshDisguises() end
		end
	end

	local card = Instance.new("Frame")
	card.Size                   = UDim2.new(1, -6, 0, ignored and 92 or 74)
	card.BackgroundColor3       = C_CARD
	card.BackgroundTransparency = ignored and 0.35 or 0
	card.BorderSizePixel        = 0
	card.LayoutOrder            = cardOrder
	card.Parent                 = eList
	uiCorner(8, card)
	addStroke(card, C_BORDER, 1)

	local stripe = Instance.new("Frame")
	stripe.Size             = UDim2.new(0, 3, 1, -14)
	stripe.Position         = UDim2.new(0, 8, 0, 7)
	stripe.BackgroundColor3 = accent
	stripe.BorderSizePixel  = 0
	stripe.Parent           = card
	uiCorner(2, stripe)

	local header = Instance.new("TextLabel")
	header.BackgroundTransparency = 1
	header.Size           = UDim2.new(1, -52, 0, 20)
	header.Position       = UDim2.new(0, 20, 0, 6)
	header.Font           = Enum.Font.GothamBold
	header.Text           = string.format("%s   •   %s", typeText, stamp)
	header.TextSize       = 13
	header.TextColor3     = accent
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.TextTruncate   = Enum.TextTruncate.AtEnd
	header.Parent         = card

	local valueColor = ignored and C_DIM or C_TEXT
	makeRow(card, 28, "Killer:", killerName, valueColor)
	makeRow(card, 48, verb .. ":", victimName, valueColor)

	if ignored then
		local tag = Instance.new("TextLabel")
		tag.BackgroundTransparency = 1
		tag.Size           = UDim2.new(1, -28, 0, 16)
		tag.Position       = UDim2.new(0, 20, 0, 70)
		tag.Font           = Enum.Font.GothamMedium
		tag.Text           = "⚖ discussion — vigilante, not counted"
		tag.TextSize       = 11
		tag.TextColor3     = C_VIGIL
		tag.TextXAlignment = Enum.TextXAlignment.Left
		tag.TextTruncate   = Enum.TextTruncate.AtEnd
		tag.Parent         = card
	end

	-- Remove button: deletes this card and undoes what it recorded.
	local removeBtn = Instance.new("TextButton")
	removeBtn.Size             = UDim2.fromOffset(18, 18)
	removeBtn.Position         = UDim2.new(1, -24, 0, 6)
	removeBtn.BackgroundColor3 = C_BTN
	removeBtn.BorderSizePixel  = 0
	removeBtn.Font             = Enum.Font.GothamBold
	removeBtn.Text             = "✕"
	removeBtn.TextSize         = 12
	removeBtn.TextColor3       = C_DIM
	removeBtn.AutoButtonColor  = true
	removeBtn.Parent           = card
	uiCorner(4, removeBtn)
	addStroke(removeBtn, C_BORDER, 1)

	removeBtn.MouseButton1Click:Connect(function()
		-- Un-credit the killer this card recorded; drop the flag if it hits 0.
		if recordedKiller then
			local left = (killersSeen[recordedKiller] or 0) - 1
			if left > 0 then
				killersSeen[recordedKiller] = left
			else
				killersSeen[recordedKiller] = nil
			end
			recordedKiller = nil
			if updateHighlights then updateHighlights() end
			if refreshDisguises then refreshDisguises() end
		end
		if not ignored and resultCount > 0 then
			resultCount -= 1
			eCount.Text = "Fires: " .. tostring(resultCount)
		end
		card:Destroy()
	end)

	task.defer(function()
		eList.CanvasPosition = Vector2.new(0, eList.AbsoluteCanvasSize.Y)
	end)
end


-- Highlights (one Highlight per character; killer red always wins)
--==================================================================
local HL_NAME  = "IdentityHighlight"       -- single highlight per character
local TAG_NAME = "IdentityDisguiseTag"     -- floating disguise-name label

local highlightEnabled  = false            -- "Highlight Killer" toggle
local disguiseHlEnabled = false            -- "Highlight Disguises" toggle
-- Name -> how many recorded (non-ignored) effects credit that killer. A name is
-- "a killer" while its count > 0; removing its last effect card drops it.
local killersSeen: { [string]: number } = {}

-- Forward declaration; assigned once isKnownKiller/getDisguiseName exist.
local updateHighlights: (() -> ())? = nil

-- Disguised = has a character whose name differs from the username.
local function isDisguised(plr: Player): (boolean, Instance?, string?)
	local char = plr.Character
	if not char then return false, nil, nil end
	if char.Name == plr.Name then return false, char, nil end
	return true, char, char.Name
end

-- kind: "killer" (red) | "disguise" (white) | nil (remove)
local function setCharHighlight(char: Instance, kind: string?)
	local hl = char:FindFirstChild(HL_NAME)
	if kind == nil then
		if hl then hl:Destroy() end
		return
	end
	if not (hl and hl:IsA("Highlight")) then
		hl = Instance.new("Highlight")
		hl.Name      = HL_NAME
		hl.Adornee   = char
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent    = char
	end
	if kind == "killer" then
		hl.FillColor           = Color3.fromRGB(255, 40, 45)
		hl.FillTransparency    = 0.75
		hl.OutlineColor        = Color3.fromRGB(255, 70, 70)
		hl.OutlineTransparency = 0.05
	else
		hl.FillColor           = Color3.fromRGB(255, 255, 255)
		hl.FillTransparency    = 0.7
		hl.OutlineColor        = Color3.fromRGB(255, 255, 255)
		hl.OutlineTransparency = 0
	end
end

-- disguiseName nil -> remove the floating tag.
local function setCharTag(char: Instance, disguiseName: string?)
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if disguiseName == nil then
		if head then
			local t = head:FindFirstChild(TAG_NAME)
			if t then t:Destroy() end
		end
		return
	end
	if not head then return end
	local tag = head:FindFirstChild(TAG_NAME)
	if not (tag and tag:IsA("BillboardGui")) then
		tag = Instance.new("BillboardGui")
		tag.Name           = TAG_NAME
		tag.Adornee        = head
		tag.Size           = UDim2.fromOffset(210, 24)
		tag.StudsOffset    = Vector3.new(0, 2.8, 0)
		tag.AlwaysOnTop    = true
		tag.LightInfluence = 0
		tag.Parent         = head

		local lbl = Instance.new("TextLabel")
		lbl.Name                   = "Label"
		lbl.BackgroundTransparency = 1
		lbl.Size                   = UDim2.fromScale(1, 1)
		lbl.Font                   = Enum.Font.GothamBold
		lbl.Text                   = disguiseName
		lbl.TextSize               = 14
		lbl.TextColor3             = Color3.fromRGB(255, 255, 255)
		lbl.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
		lbl.TextStrokeTransparency = 0.35
		lbl.Parent                 = tag
	else
		local lbl = tag:FindFirstChild("Label")
		if lbl and lbl:IsA("TextLabel") then
			lbl.Text = disguiseName
		end
	end
end

local function clearAllHighlights()
	for _, d in ipairs(Workspace:GetDescendants()) do
		if (d:IsA("Highlight") and d.Name == HL_NAME)
			or (d:IsA("BillboardGui") and d.Name == TAG_NAME) then
			d:Destroy()
		end
	end
end


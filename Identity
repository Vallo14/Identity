-- Toggle keybinds (recorded from the Misc tab). Stored as KeyCode names.
local function resolveKey(name: any): EnumItem?
	if type(name) ~= "string" then return nil end
	local ok, k = pcall(function() return (Enum.KeyCode :: any)[name] end)
	if ok and typeof(k) == "EnumItem" then return k end
	return nil
end
local noclipKey: EnumItem? = resolveKey(getSetting("noclipKey", nil))
local fbKey: EnumItem?     = resolveKey(getSetting("fbKey", nil))
local listeningFor: string? = nil   -- "noclip" | "fullbright" while recording

local CAM_BIND = "IdentityTeleportLook"
local camLookEye: BasePart? = nil
local camLookTarget: BasePart? = nil
local camLookOn = false

local function stopCameraLook()
	if camLookOn then
		camLookOn = false
		pcall(function() RunService:UnbindFromRenderStep(CAM_BIND) end)
	end
	camLookEye = nil
	camLookTarget = nil
end

-- Force the camera to face `targetPart` from `eyePart`, holding until stopped.
local function startCameraLook(eyePart: BasePart, targetPart: BasePart)
	camLookEye = eyePart
	camLookTarget = targetPart
	if camLookOn then return end
	camLookOn = true
	RunService:BindToRenderStep(CAM_BIND, Enum.RenderPriority.Camera.Value + 1, function()
		local cam = Workspace.CurrentCamera
		if not cam or not camLookEye or not camLookTarget
			or not camLookEye.Parent or not camLookTarget.Parent then
			return
		end
		cam.CFrame = CFrame.lookAt(
			camLookEye.Position + Vector3.new(0, 1.5, 0),
			camLookTarget.Position + Vector3.new(0, 1.5, 0)
		)
	end)
end

-- For teleport-to-disguise: keep facing the target until the player moves the
-- camera (or 3s pass), then hand control back.
local function releaseCameraLookOnInput()
	task.spawn(function()
		local released = false
		local conn: RBXScriptConnection? = nil
		local function release()
			if released then return end
			released = true
			if conn then conn:Disconnect() end
			stopCameraLook()
		end
		conn = UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				release()
			end
		end)
		task.delay(3, release)
	end)
end


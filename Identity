--==================================================================
-- Effect parsing
--==================================================================
local function collect(value: any, out: { any }, depth: number)
	if depth > 5 then return end
	if typeof(value) == "table" then
		local seen: { [any]: boolean } = {}
		for i, v in ipairs(value) do
			seen[i] = true
			collect(v, out, depth + 1)
		end
		for k, v in pairs(value) do
			if not seen[k] then
				collect(v, out, depth + 1)
			end
		end
	else
		table.insert(out, value)
	end
end

local function flatten(args: { n: number, [number]: any }): { any }
	local flat: { any } = {}
	for i = 1, args.n do
		collect(args[i], flat, 0)
	end
	return flat
end

local function parseFlat(flat: { any })
	local killType, killer, victim = nil, nil, nil
	local instCount = 0
	for _, v in ipairs(flat) do
		local ty = typeof(v)
		if ty == "string" and killType == nil then
			killType = v
		elseif ty == "Instance" then
			instCount += 1
			if instCount == 1 then killer = v
			elseif instCount == 2 then victim = v end
		end
	end
	return killType, killer, victim
end

local function nameOf(v: any): string
	if typeof(v) == "Instance" then
		return v.Name
	elseif v == nil then
		return "?"
	end
	return tostring(v)
end

local function verbFor(dmgType: any): string
	local t = string.lower(tostring(dmgType))
	if string.find(t, "gun") or string.find(t, "shot") or string.find(t, "bullet") then
		return "Shot"
	elseif string.find(t, "knife") or string.find(t, "stab")
		or string.find(t, "wound") or string.find(t, "blade") then
		return "Stabbed"
	end
	return "Hit"
end

local function colorFor(dmgType: any): Color3
	local verb = verbFor(dmgType)
	if verb == "Shot" then return Color3.fromRGB(255, 170, 60) end
	if verb == "Stabbed" then return Color3.fromRGB(255, 90, 100) end
	return Color3.fromRGB(120, 170, 255)
end

local function hasUnknownInfo(flat: { any }): boolean
	for _, v in ipairs(flat) do
		if typeof(v) == "string" and string.find(v, "???", 1, true) then
			return true
		end
	end
	return false
end


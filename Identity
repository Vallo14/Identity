-- Persisted user settings. Uses the executor filesystem API when present;
-- silently no-ops (defaults only) if the executor doesn't expose it.
local SETTINGS_FILE = "IdentityMonitorV2_settings.json"
local SETTINGS: { [string]: any } = {}
do
	local ok, data = pcall(function()
		if isfile and readfile and isfile(SETTINGS_FILE) then
			return HttpService:JSONDecode(readfile(SETTINGS_FILE))
		end
		return nil
	end)
	if ok and typeof(data) == "table" then
		SETTINGS = data
	end
end

local function getSetting(key: string, default: any): any
	local v = SETTINGS[key]
	if v == nil then return default end
	return v
end

-- Remotes are located in the background so the GUI always opens immediately —
-- even in the lobby where these services don't exist yet.
local function findRemote(...): Instance?
	local path = { ... }
	local ok, result = pcall(function()
		local node: Instance = ReplicatedStorage
		for _, name in ipairs(path) do
			node = node:WaitForChild(name, 15)
		end
		return node
	end)
	if ok then return result end
	return nil
end


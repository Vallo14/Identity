local function getDisguiseName(plr: Player): string
	local char = plr.Character
	if not char then return "(no character)" end
	if char.Name == plr.Name then return "(not disguised)" end
	return char.Name
end

local function isKnownKiller(plr: Player, disguise: string): boolean
	if disguise ~= "" and killersSeen[disguise] then return true end
	if killersSeen[plr.Name] then return true end
	local char = plr.Character
	if char and killersSeen[char.Name] then return true end
	return false
end


	hit.ZIndex                 = 3
	hit.Parent                 = parent

	local function apply(v: number)
		v = math.clamp(math.floor(v + 0.5), minV, maxV)
		local frac = (maxV > minV) and (v - minV) / (maxV - minV) or 0
		fill.Size     = UDim2.new(frac, 0, 1, 0)
		knob.Position = UDim2.new(frac, -7, 0.5, -7)
		label.Text    = string.format(fmt, v)
		onChange(v)
	end

	local dragging = false
	local function fromX(px: number)
		local w = track.AbsoluteSize.X
		if w <= 0 then return end
		local frac = math.clamp((px - track.AbsolutePosition.X) / w, 0, 1)
		apply(minV + frac * (maxV - minV))
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	table.insert(sliderConns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end))
	table.insert(sliderConns, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))

	apply(default)
	return apply  -- setter so callers can move the slider programmatically
end


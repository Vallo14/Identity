-- Mafia: disguise -> true-username map + action stubs
--==================================================================
-- Live disguise -> true-username map, auto-built from the Disguises tab data.
-- Nothing to fill in by hand; rebuilt every refresh by rebuildDisguiseLookup().
local disguiseLookup: { [string]: string } = {}

local function resolveTarget(text: string?): string?
	if not text then return nil end
	text = (text:gsub("^%s+", ""):gsub("%s+$", ""))
	if text == "" then return nil end
	local mapped = disguiseLookup[string.lower(text)]
	if mapped and mapped ~= "" then
		return mapped        -- known disguise/alias -> real username
	end
	return text              -- treat as a raw username
end


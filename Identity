local function addResult(killType: any, killer: any, victim: any, ignored: boolean)
	cardOrder += 1

	local killerName = nameOf(killer)
	local victimName = nameOf(victim)
	local typeText   = killType ~= nil and tostring(killType) or "?"
	local verb       = verbFor(killType)
	local accent     = ignored and C_VIGIL or colorFor(killType)
	local stamp      = os.date("%H:%M:%S")
	local recordedKiller: string? = nil

	print(string.format("[Identity Monitor] %s%s | Killer: %s | %s: %s",
		ignored and "(discussion/vigilante) " or "", typeText, killerName, verb, victimName))

	if not ignored then
		resultCount += 1
		eCount.Text = "Fires: " .. tostring(resultCount)
		if killerName ~= "" and killerName ~= "?" then
			recordedKiller = killerName
			killersSeen[killerName] = (killersSeen[killerName] or 0) + 1
			if updateHighlights then updateHighlights() end
			if refreshDisguises then refreshDisguises() end
		end
	end

	local card = Instance.new("Frame")
	card.Size                   = UDim2.new(1, -6, 0, ignored and 92 or 74)
	card.BackgroundColor3       = C_CARD
	card.BackgroundTransparency = ignored and 0.35 or 0
	card.BorderSizePixel        = 0
	card.LayoutOrder            = cardOrder
	card.Parent                 = eList
	uiCorner(8, card)
	addStroke(card, C_BORDER, 1)

	local stripe = Instance.new("Frame")
	stripe.Size             = UDim2.new(0, 3, 1, -14)
	stripe.Position         = UDim2.new(0, 8, 0, 7)
	stripe.BackgroundColor3 = accent

eventConn = Event.OnClientEvent:Connect(function(...)
	local flat = flatten(table.pack(...))
	local killType, killer, victim = parseFlat(flat)

	-- Shots & Stabs Only: drop anything that isn't a gunshot / knife stab,
	-- plus gunshots that carry "???" (unknown) info.
	if killsOnlyEnabled then
		local verb = verbFor(killType)
		if verb ~= "Shot" and verb ~= "Stabbed" then return end
		if verb == "Shot" and hasUnknownInfo(flat) then return end
	end

	-- Kills during discussion music are vigilante kills — flagged, not counted.
	local ignored = discussionFilterEnabled and (currentMusic == DISCUSSION_MUSIC_NAME)

	addResult(killType, killer, victim, ignored)
end)

local function hookPlayer(plr: Player)
	plr.CharacterAdded:Connect(function()
		if refreshDisguises then refreshDisguises() end
		if (highlightEnabled or disguiseHlEnabled) and updateHighlights then
			task.defer(updateHighlights)
		end
	end)
	plr.CharacterRemoving:Connect(function()
		task.defer(function()
			if refreshDisguises then refreshDisguises() end
		end)
	end)
end

for _, plr in ipairs(Players:GetPlayers()) do

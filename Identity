-- Auto-build the disguise -> true-username lookup from live player data.
local function rebuildDisguiseLookup()
	table.clear(disguiseLookup)
	for _, plr in ipairs(Players:GetPlayers()) do
		local uname = plr.Name
		disguiseLookup[string.lower(uname)] = uname
		if plr.DisplayName ~= "" and plr.DisplayName ~= uname then
			disguiseLookup[string.lower(plr.DisplayName)] = uname
		end
		local disguise = getDisguiseName(plr)
		if disguise ~= "(no character)" and disguise ~= "(not disguised)" then
			disguiseLookup[string.lower(disguise)] = uname
		end
	end
end

-- Unified highlight pass. Killer red always wins; disguised non-killers (and
-- killers, when the killer toggle is off) get white; name tags show for any
-- disguised player while the disguise highlight is on.
updateHighlights = function()
	for _, plr in ipairs(Players:GetPlayers()) do
		local disguised, char, disguise = isDisguised(plr)
		if char then
			local killer = isKnownKiller(plr, disguise or "")
			local kind: string? = nil
			if highlightEnabled and killer then
				kind = "killer"
			elseif disguiseHlEnabled and disguised then
				kind = "disguise"
			end
			setCharHighlight(char, kind)
			if disguiseHlEnabled and disguised then
				setCharTag(char, disguise)
			else
				setCharTag(char, nil)
			end
		end
	end
end

refreshDisguises = function()
	rebuildDisguiseLookup()

	for _, c in ipairs(dList:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end

	local players = Players:GetPlayers()
	table.sort(players, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	local killerCount = 0
	for i, plr in ipairs(players) do
		local disguise = getDisguiseName(plr)
		local killer = isKnownKiller(plr, disguise ~= "(no character)" and disguise ~= "(not disguised)" and disguise or "")
		if killer then killerCount += 1 end
		makeDisguiseRow(i, plr, disguise, killer)
	end

	dCount.Text = string.format("Players: %d  ·  Killers: %d", #players, killerCount)
end


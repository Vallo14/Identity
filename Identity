-- Fullbright: flatten all lighting so there's no darkness (Effects toggle).
local fullbrightEnabled = false
local fbSaved: { [string]: any }? = nil

local fbApplying = false  -- guards against reacting to our own Lighting writes

local function applyFullbrightValues()
	fbApplying = true
	Lighting.Brightness           = 2
	Lighting.ClockTime            = 12
	Lighting.FogEnd               = 1e9
	Lighting.FogStart             = 0
	Lighting.GlobalShadows        = false
	Lighting.Ambient              = Color3.fromRGB(200, 200, 200)
	Lighting.OutdoorAmbient       = Color3.fromRGB(200, 200, 200)
	Lighting.ExposureCompensation = 0
	fbApplying = false
end

local function setFullbright(on: boolean)
	if on then
		if not fbSaved then
			fbSaved = {
				Brightness           = Lighting.Brightness,
				ClockTime            = Lighting.ClockTime,
				FogEnd               = Lighting.FogEnd,
				FogStart             = Lighting.FogStart,
				GlobalShadows        = Lighting.GlobalShadows,
				Ambient              = Lighting.Ambient,
				OutdoorAmbient       = Lighting.OutdoorAmbient,
				ExposureCompensation = Lighting.ExposureCompensation,
			}
		end
		applyFullbrightValues()
	elseif fbSaved then
		fbApplying = true
		Lighting.Brightness           = fbSaved.Brightness
		Lighting.ClockTime            = fbSaved.ClockTime
		Lighting.FogEnd               = fbSaved.FogEnd
		Lighting.FogStart             = fbSaved.FogStart
		Lighting.GlobalShadows        = fbSaved.GlobalShadows
		Lighting.Ambient              = fbSaved.Ambient
		Lighting.OutdoorAmbient       = fbSaved.OutdoorAmbient
		Lighting.ExposureCompensation = fbSaved.ExposureCompensation
		fbApplying = false
	end
end

-- Re-assert fullbright the moment the game changes any lighting (e.g. lights
-- off) so it can't be turned back off underneath us.
local fbChangedConn: RBXScriptConnection = Lighting.Changed:Connect(function()
	if fullbrightEnabled and not fbApplying then
		applyFullbrightValues()
	end
end)

-- No-clip (Misc toggle): force the local character's parts non-collidable each
-- frame while on, remembering each part's original CanCollide to restore later.
local noclipEnabled = false
local noclipConn: RBXScriptConnection? = nil
local noclipOriginals: { [BasePart]: boolean } = {}

local function stopNoclip()
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end
	for part, orig in pairs(noclipOriginals) do
		if part and part.Parent then
			part.CanCollide = orig
		end
	end
	table.clear(noclipOriginals)
end

local function startNoclip()
	if noclipConn then return end
	noclipConn = RunService.Stepped:Connect(function()
		local char = localPlayer.Character
		if not char then return end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				if noclipOriginals[part] == nil then
					noclipOriginals[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end
	end)
end

local function setNoclip(on: boolean)
	noclipEnabled = on
	if on then startNoclip() else stopNoclip() end
end


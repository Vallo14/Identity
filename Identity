local keybindConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local key = input.KeyCode
	if key == Enum.KeyCode.Unknown then return end

	if listeningFor then
		-- Escape cancels; otherwise record. Clear the key off the other action
		-- so one key never toggles both.
		if key ~= Enum.KeyCode.Escape then
			if listeningFor == "noclip" then
				if fbKey == key then fbKey = nil end
				noclipKey = key
			else
				if noclipKey == key then noclipKey = nil end
				fbKey = key
			end
		end
		listeningFor = nil
		updateBindButtons()
		queueSave()
		return
	end

	if gameProcessed then return end  -- ignore while typing in a text box
	if noclipKey and key == noclipKey then
		setNoclip(not noclipEnabled)
		updateNoclipButton()
		queueSave()
	elseif fbKey and key == fbKey then
		fullbrightEnabled = not fullbrightEnabled
		setFullbright(fullbrightEnabled)
		updateFbButton()
		queueSave()
	end
end)


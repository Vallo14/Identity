-- Teleport-stab timing slider
local function setTpFrames(v: number)
	v = math.clamp(math.floor(v + 0.5), 0, MAX_TP_FRAMES)
	tpStabFrames = v
	local frac = v / MAX_TP_FRAMES
	sliderFill.Size     = UDim2.new(frac, 0, 1, 0)
	sliderKnob.Position = UDim2.new(frac, -7, 0.5, -7)
	sliderLabel.Text = string.format(
		"Teleport frames: %d  •  frames to complete (0 = instant)", v)
end

local function sliderSetFromX(px: number)
	local w = sliderTrack.AbsoluteSize.X
	if w <= 0 then return end
	local frac = math.clamp((px - sliderTrack.AbsolutePosition.X) / w, 0, 1)
	setTpFrames(frac * MAX_TP_FRAMES)
end

